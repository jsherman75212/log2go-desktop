{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Log2Go Desktop",
  "version": "0.2.0",
  "identifier": "net.ke5zqv.log2go.desktop",
  "build": {
    "frontendDist": "../dist-renderer",
    "devUrl": "http://localhost:54337",
    "beforeDevCommand": "npm run preview:web",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Log2Go Desktop",
        "width": 1440,
        "height": 920,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}